rules_version = '2';

// Who may use the scorebook is kept in the database, not here (this file is public on GitHub):
// one document per allowed Google account in access/, named by the email address in lower case,
// e.g. access/coach@dalton.org. Only the project owner can add or remove them (from the Firebase
// console or the admin API); the app itself can only check its own entry.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/access/$(email()));
    }
    match /access/{address} {
      allow read: if request.auth != null && request.auth.token.email_verified == true && email() == address;
    }
    match /books/{book} {
      allow read, write: if allowed();
    }
    match /books/{book}/{rest=**} {
      allow read, write: if allowed();
    }
  }
}
